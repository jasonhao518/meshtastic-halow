#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>

/*
 * DK-base overlay for the custom E73-2G4M08S1F wiring.
 * This avoids Seeed XIAO board nodes such as xiao_d/xiao_spi while keeping
 * the same physical pins used by the normal nRF54L15 HaLow setup.
 */

/ {
	leds {
		compatible = "gpio-leds";

		user_led: user_led {
			gpios = <&gpio2 5 GPIO_ACTIVE_LOW>;
			label = "User LED";
		};
	};

	aliases {
		led0 = &user_led;
		imu0 = &lsm6ds3;
		l76k-uart = &uart30;
	};

	zephyr,user {
		io-channels = <&adc 7>;
		vbat-en-gpios = <&gpio1 14 GPIO_ACTIVE_HIGH>;
		halow-power-en-gpios = <&gpio2 0 GPIO_ACTIVE_HIGH>;
		key-gpios = <&gpio2 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		l76k-wake-gpios = <&gpio1 9 GPIO_ACTIVE_HIGH>;
		imu-scl-gpios = <&gpio2 6 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>;
		imu-sda-gpios = <&gpio2 8 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>;
	};
};

&pinctrl {
	uart30_l76k_default: uart30_l76k_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 12)>;
		};

		group2 {
			psels = <NRF_PSEL(UART_RX, 1, 11)>;
			bias-pull-up;
		};
	};

	uart30_l76k_sleep: uart30_l76k_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 12)>,
				<NRF_PSEL(UART_RX, 1, 11)>;
			low-power-enable;
		};
	};

	i2c21_default: i2c21_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 2, 6)>,
				<NRF_PSEL(TWIM_SDA, 2, 8)>;
			bias-pull-up;
		};
	};

	i2c21_sleep: i2c21_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 2, 6)>,
				<NRF_PSEL(TWIM_SDA, 2, 8)>;
			low-power-enable;
		};
	};

	spi00_halow_default: spi00_halow_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 2, 1)>,
				<NRF_PSEL(SPIM_MISO, 2, 4)>,
				<NRF_PSEL(SPIM_MOSI, 2, 2)>;
		};
	};

	spi00_halow_sleep: spi00_halow_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 2, 1)>,
				<NRF_PSEL(SPIM_MISO, 2, 4)>,
				<NRF_PSEL(SPIM_MOSI, 2, 2)>;
			low-power-enable;
		};
	};
};

&uart30 {
	status = "okay";
	current-speed = <9600>;
	pinctrl-0 = <&uart30_l76k_default>;
	pinctrl-1 = <&uart30_l76k_sleep>;
	pinctrl-names = "default", "sleep";
};

&uart21 {
	status = "disabled";
};

&i2c21 {
	status = "okay";
	compatible = "nordic,nrf-twim";
	pinctrl-0 = <&i2c21_default>;
	pinctrl-1 = <&i2c21_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <I2C_BITRATE_STANDARD>;

	lsm6ds3: lsm6ds3@6a {
		compatible = "st,lsm6dsl";
		reg = <0x6a>;
		status = "okay";
	};
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN6>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <4>;
	};
};

&spi00 {
	status = "okay";
	cs-gpios = <&gpio1 7 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <&spi00_halow_default>;
	pinctrl-1 = <&spi00_halow_sleep>;
	pinctrl-names = "default", "sleep";

	morse_wifi: morse@0 {
		status = "okay";
		compatible = "morse,mm6108";
		spi-max-frequency = <12000000>;
		reg = <0>;

		spi-irq-gpios = <&gpio1 6 GPIO_ACTIVE_LOW>;
		busy-gpios = <&gpio1 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		wakeup-gpios = <&gpio1 5 GPIO_ACTIVE_HIGH>;
		resetn-gpios = <&gpio1 4 GPIO_ACTIVE_LOW>;
	};
};
